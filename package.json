{
  "name": "vol-nq-mnq-risk-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Risk-first NQ and MNQ planner using controlled NQ adverse-movement history.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data": "node scripts/run-python.mjs scripts/build_dashboard_data.py",
    "dev": "npm run build:github && node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "dev:vinext": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:github": "vite build --config vite.github.config.ts",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run lint && npm run typecheck && npm run build && npm run build:github && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.13.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.4.0",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
